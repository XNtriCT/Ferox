{
  "name": "ferox-browser",
  "version": "1.2.0",
  "description": "Ferox - Brave Browser fork with continuous 1x-4x mouse speed control, single-tap video speed toolbar, and Brave Shields ad-blocking",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "pack": "powershell -ExecutionPolicy Bypass -File scripts/build_fast_portable.ps1",
    "pack:portable": "electron-builder --win portable"
  },
  "keywords": [
    "brave",
    "browser",
    "adblocker",
    "youtube",
    "playback-speed"
  ],
  "author": "Ferox Project",
  "license": "MPL-2.0",
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "cross-fetch": "^4.1.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ferox.browser",
    "productName": "Ferox",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "engine/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Ferox-Setup.exe"
    }
  }
}
