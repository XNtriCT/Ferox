<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar & Omnibox -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/bg_secondary"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Honey Badger App Logo & Brave Shields Button with Blocked Counter -->
            <LinearLayout
                android:id="@+id/btnShields"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_shield_btn"
                android:paddingStart="6dp"
                android:paddingEnd="8dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/app_logo"
                    android:contentDescription="Ferox" />

                <TextView
                    android:id="@+id/textShieldsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/accent_orange"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Omnibox Search / URL Input -->
            <EditText
                android:id="@+id/urlEditText"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_omnibox"
                android:hint="Search or type URL"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:singleLine="true"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Speed Indicator Pill in Top Bar -->
            <TextView
                android:id="@+id/btnSpeedPill"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_speed_pill"
                android:gravity="center"
                android:text="1x"
                android:drawableStart="@drawable/ic_bolt"
                android:drawablePadding="4dp"
                android:textColor="@color/accent_orange"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Loading Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progressTint="@color/accent_orange"
            android:visibility="gone" />

        <!-- Speed Selection Bar: directly below the URL space, like the web app -->
        <HorizontalScrollView
            android:id="@+id/speedBarScroll"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="@color/bg_primary"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/speedButtonsContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">
                <!-- Compact speed pills are added dynamically in MainActivity -->
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Content Area: Browse WebView & Dedicated Player WebView -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.ferox.browser.AlwaysVisibleWebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Dedicated YouTube watch page player: full size or scaled into
                 the mini player rect. The WebView itself is added
                 programmatically so it is only created when a video opens.
                 In mini mode this container is scaled/translated, so the
                 WebView itself is never resized (YouTube keeps playing). -->
            <FrameLayout
                android:id="@+id/playerContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                android:visibility="gone" />

            <!-- Mini player tap/close overlay, aligned with the scaled
                 player rect (208dp x 117dp = 16:9). -->
            <FrameLayout
                android:id="@+id/miniOverlay"
                android:layout_width="208dp"
                android:layout_height="117dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone">

                <!-- Transparent shield so tapping the mini player expands it -->
                <View
                    android:id="@+id/miniTouchShield"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Close button shown only in mini player mode -->
                <ImageButton
                    android:id="@+id/btnCloseMini"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="4dp"
                    android:background="#CC000000"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="#FFFFFF"
                    android:contentDescription="Close mini player" />
            </FrameLayout>
        </FrameLayout>

        <!-- Bottom Navigation Bar (buttons pushed to the sides to make room for the bubble) -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:background="@color/bg_deep"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="12dp"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_nav_back"
                android:tint="@color/text_secondary"
                android:contentDescription="Back" />

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_nav_forward"
                android:tint="@color/text_secondary"
                android:contentDescription="Forward" />

            <!-- Center gap reserved for the draggable speed bubble -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_nav_search"
                android:tint="@color/accent_orange"
                android:contentDescription="Brave Search" />

            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="12dp"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_nav_refresh"
                android:tint="@color/text_secondary"
                android:contentDescription="Reload" />
        </LinearLayout>

    </LinearLayout>

    <!-- Drag-and-Hold Speed Bubble (globule) between the next and search buttons -->
    <FrameLayout
        android:id="@+id/speedBubble"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_gravity="bottom|center_horizontal">

        <View
            android:id="@+id/bubbleGlow"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:background="@drawable/bg_bubble_glow" />

        <View
            android:id="@+id/bubbleRipple1"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_bubble_ripple" />

        <View
            android:id="@+id/bubbleRipple2"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_bubble_ripple" />

        <View
            android:id="@+id/bubbleCore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_bubble_core" />

        <TextView
            android:id="@+id/bubbleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="1x"
            android:textColor="@color/text_on_accent"
            android:textStyle="bold"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center" />
    </FrameLayout>

    <!-- Live speed readout shown while the bubble is held -->
    <TextView
        android:id="@+id/textSpeedReadout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="118dp"
        android:background="@drawable/bg_speed_readout"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="1x"
        android:textColor="@color/accent_orange"
        android:textStyle="bold"
        android:textSize="26sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone" />

    <!-- True fullscreen video overlay (covers the whole screen). The video
         view is inset on the right so the vertical speed slider never covers
         the video content. -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/fullscreenSpeedPanel"
            android:layout_width="56dp"
            android:layout_height="280dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_speed_readout"
            android:visibility="gone">

            <TextView
                android:id="@+id/fullscreenSpeedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1x"
                android:textColor="@color/accent_orange"
                android:textStyle="bold"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:paddingBottom="4dp" />

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="220dp">

                <SeekBar
                    android:id="@+id/fullscreenSpeedSeek"
                    android:layout_width="220dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:rotation="-90"
                    android:max="60"
                    android:progress="0"
                    android:progressTint="@color/accent_orange"
                    android:progressBackgroundTint="#55FFFFFF"
                    android:thumbTint="@color/accent_orange" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
