<?xml version="1.0" encoding="utf-8"?>
<!-- Raised surface: warm-tinted highlight on top, cool navy at the base,
     with a soft brand-tinted border (tactile realism). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="18dp" />
    <gradient
        android:angle="270"
        android:startColor="#2A3346"
        android:centerColor="#1D2434"
        android:endColor="#161B29" />
    <stroke
        android:width="1dp"
        android:color="#59F79A2E" />
</shape>
