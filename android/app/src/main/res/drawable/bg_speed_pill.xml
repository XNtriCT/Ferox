<?xml version="1.0" encoding="utf-8"?>
<!-- Brand-tinted glass pill: warm orange wash on top fading to deep navy. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <gradient
        android:angle="270"
        android:startColor="#3A2B1C"
        android:centerColor="#2A2118"
        android:endColor="#1E1B22" />
    <stroke
        android:width="1dp"
        android:color="#66F79A2E" />
</shape>
