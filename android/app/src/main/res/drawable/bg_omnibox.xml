<?xml version="1.0" encoding="utf-8"?>
<!-- Sunken field: dark at the top (recessed), faintly lifted at the base,
     hairline cool border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:angle="270"
        android:startColor="#080B11"
        android:centerColor="#0B0E16"
        android:endColor="#0E121B" />
    <stroke
        android:width="1dp"
        android:color="#14FFFFFF" />
</shape>
