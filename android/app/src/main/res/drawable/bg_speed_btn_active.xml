<?xml version="1.0" encoding="utf-8"?>
<!-- Active speed pill: brand gradient (warm highlight -> deep orange),
     light catch-light border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <gradient
        android:angle="270"
        android:startColor="#FFC061"
        android:centerColor="#F79A2E"
        android:endColor="#E8791B" />
    <stroke
        android:width="1dp"
        android:color="#99FFD08A" />
</shape>
