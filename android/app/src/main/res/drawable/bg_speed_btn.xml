<?xml version="1.0" encoding="utf-8"?>
<!-- Idle speed pill: subtle raised surface with warm top light. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <gradient
        android:angle="270"
        android:startColor="#232B3D"
        android:centerColor="#1B2130"
        android:endColor="#171C29" />
    <stroke
        android:width="1dp"
        android:color="#12FFFFFF" />
</shape>
